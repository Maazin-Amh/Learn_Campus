{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'displayName']) && newData.child('uid').val() === $uid"
      }
    },
    "usernameLookup": {
      "$username": {
        ".read": "auth != null && $username.matches(/^[a-z0-9_]{3,20}$/)",
        ".write": "auth != null && $username.matches(/^[a-z0-9_]{3,20}$/) && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },
    "usernameOwners": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/)"
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "courses": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "chats": {
      "$thread": {
        "members": {
          ".read": "auth != null && data.child(auth.uid).val() === true",
          ".write": "auth != null && newData.child(auth.uid).val() === true && (data.child(auth.uid).val() === true || !data.exists())"
        },
        "messages": {
          ".read": "auth != null && root.child('chats').child($thread).child('members').child(auth.uid).val() === true",
          "$message": {
            ".write": "auth != null && root.child('chats').child($thread).child('members').child(auth.uid).val() === true && newData.child('senderId').val() === auth.uid",
            ".validate": "newData.hasChildren(['senderId', 'text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length <= 2000"
          }
        }
      }
    }
  }
}
